		[PerRendererData] _AlphaTex ("External Alpha", 2D) = "white" {}
		_GroundColor("GroundColor", Color) = (0.259434,0.9630086,1,1)
		_WallColor("WallColor", Color) = (0,0.3872362,0.6415094,1)
